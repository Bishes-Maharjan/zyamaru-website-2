generator erpClient {
  provider = "prisma-client"
  output   = "../src/generated/erp-client"
}

datasource erp_db {
  provider = "postgresql"
}

model accounts {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  users             users   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model allowed_emails {
  id        String   @id
  email     String   @unique
  role      UserRole @default(staff)
  isActive  Boolean  @default(true)
  addedBy   String?
  createdAt DateTime @default(now())
}

model categories {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  products    products[]
}

model customers {
  id          Int      @id @default(autoincrement())
  name        String
  companyName String?
  contact     String?  @unique
  email       String?  @unique
  createdAt   DateTime @default(now())
  address     String?
  sales       sales[]
}

model inventory {
  id                            Int                  @id @default(autoincrement())
  productId                     Int
  batchId                       Int
  poItemId                      Int
  quantityAvailable             Int                  @default(0)
  dateAdded                     DateTime             @default(now())
  estimatedSellingPricePerPiece Decimal?             @erp_db.Decimal(10, 2)
  finalCostNprPerPiece          Decimal              @erp_db.Decimal(10, 2)
  initialCostNprPerPiece        Decimal              @erp_db.Decimal(10, 2)
  purchase_orders               purchase_orders      @relation(fields: [batchId], references: [id])
  purchase_order_items          purchase_order_items @relation(fields: [poItemId], references: [id])
  products                      products             @relation(fields: [productId], references: [id])
  sale_items                    sale_items[]
}

model product_images {
  id        Int      @id @default(autoincrement())
  url       String
  publicId  String?
  productId Int
  createdAt DateTime @default(now())
  products  products @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model products {
  id                   Int                    @id @default(autoincrement())
  productName          String
  modelName            String?
  createdAt            DateTime               @default(now())
  categoryId           Int?
  description          String?
  inventory            inventory[]
  product_images       product_images[]
  categories           categories?            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  purchase_order_items purchase_order_items[]
  sale_items           sale_items[]

  @@unique([productName, modelName])
}

model purchase_order_items {
  id                     Int             @id @default(autoincrement())
  batchId                Int
  productId              Int
  quantityOrdered        Int
  quantityReceived       Int?
  notes                  String?
  createdAt              DateTime        @default(now())
  rmbToNprRate           Decimal         @erp_db.Decimal(10, 4)
  markUp                 Decimal?        @erp_db.Decimal(10, 2)
  finalCostNprPerPiece   Decimal?        @erp_db.Decimal(12, 2)
  initialCostNprPerPiece Decimal         @erp_db.Decimal(12, 2)
  initialCostRmbPerPiece Decimal         @erp_db.Decimal(12, 2)
  inventory              inventory[]
  purchase_orders        purchase_orders @relation(fields: [batchId], references: [id])
  products               products        @relation(fields: [productId], references: [id])
}

model purchase_orders {
  id                   Int                    @id @default(autoincrement())
  batchNumber          String                 @unique
  orderDate            DateTime
  receivedDate         DateTime?
  status               OrderStatus            @default(ordered)
  supplierName         String?
  notes                String?
  createdAt            DateTime               @default(now())
  totalPrice           Decimal?               @erp_db.Decimal(14, 2)
  inventory            inventory[]
  purchase_order_items purchase_order_items[]
}

model sale_items {
  id             Int       @id @default(autoincrement())
  saleId         Int
  inventoryId    Int
  productId      Int
  quantitySold   Int
  unitPrice      Decimal   @erp_db.Decimal(10, 2)
  discountAmount Decimal   @default(0) @erp_db.Decimal(10, 2)
  finalPrice     Decimal   @erp_db.Decimal(10, 2)
  netProfit      Decimal?  @erp_db.Decimal(10, 2)
  createdAt      DateTime  @default(now())
  inventory      inventory @relation(fields: [inventoryId], references: [id])
  products       products  @relation(fields: [productId], references: [id])
  sales          sales     @relation(fields: [saleId], references: [id])
}

model sales {
  id                Int           @id @default(autoincrement())
  saleDate          DateTime
  customerId        Int?
  soldBy            String
  paymentMethod     PaymentMethod
  totalAmount       Decimal       @erp_db.Decimal(10, 2)
  createdAt         DateTime      @default(now())
  purposerForBuying String?
  sale_items        sale_items[]
  customers         customers?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  users             users         @relation(fields: [soldBy], references: [id])
}

model sessions {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  users        users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model users {
  id            String     @id
  email         String     @unique
  name          String?
  image         String?
  emailVerified DateTime?
  role          UserRole   @default(staff)
  isActive      Boolean    @default(true)
  addedBy       String?
  createdAt     DateTime   @default(now())
  accounts      accounts[]
  sales         sales[]
  sessions      sessions[]
  users         users?     @relation("usersTousers", fields: [addedBy], references: [id])
  other_users   users[]    @relation("usersTousers")
}

model verification_tokens {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum OrderStatus {
  ordered
  in_transit
  received
  cancelled
}

enum PaymentMethod {
  cash
  online
}

enum UserRole {
  owner
  manager
  staff
}
