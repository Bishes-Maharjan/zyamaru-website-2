generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model ContactForm {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String
  subject   String
  message   String
  type      Type     @default(ENROLLMENT)
  createdAt DateTime @default(now())
}

model StayUpdatedEmail {
  id        Int      @id @default(autoincrement())
  email     String
  createdAt DateTime @default(now())
}

model BlogPostCache {
  id           String        @id @default(cuid())
  pageId       String        @unique
  slug         String        @unique
  title        String
  description  String?
  coverUrl     String?
  status       String
  markdown     String
  lastSyncedAt DateTime      @default(now())
  author       String?
  tag          String?
  images       NotionImage[] @relation("PostImages")
}

model NotionImage {
  id        String        @id @default(cuid())
  blockId   String        @unique
  hostedUrl String
  notionUrl String?
  width     Int?
  height    Int?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  postId    String
  post      BlogPostCache @relation("PostImages", fields: [postId], references: [id])

  @@index([postId])
}

enum Type {
  CAREER
  ENROLLMENT
}
